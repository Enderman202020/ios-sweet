diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
index 0000000..22ca799
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,170 @@
+/*
+ * sweet_gpu.c - power the GPU's GX domain, which is what a probe could not do.
+ *
+ * WHY ONLY THIS
+ *
+ * Four of the five GPU bring-up steps are already proven on this phone by the
+ * shim probes booted with `fastboot boot`: the SMMU context with real page
+ * tables, the GMU firmware running (`0xbabeface`), the HFI queues and the whole
+ * four-message handshake.  None of that needs to move yet.
+ *
+ * The fifth did not work there, and cannot: the GX domain stays off because
+ * `GPUCC_GX_GDSCR` reads `0x02220001` -- SW_COLLAPSE set, POWER_ON clear -- and
+ * clearing SW_COLLAPSE alone gives `0x02220000` with POWER_ON still clear.  The
+ * domain needs its supply rail `gfx.lvl` voted up through RPMh, and RPMh votes
+ * need the RSC's TCS registers, which sweet_rpmh.c already owns.  That is the
+ * one thing a fastboot image cannot do and a kernel driver can.
+ *
+ * So this file does one job and reports everything it sees:
+ *
+ *     1. vote gfx.lvl up through sweet_rpmh.c      (the new part)
+ *     2. clear SW_COLLAPSE on the GX GDSC
+ *     3. read back whether POWER_ON came up
+ *
+ * If step 3 succeeds, the shim's remaining work (SPTPRAC, CORE_REQUEST, the
+ * command ring) can follow, and the probe image can go back to being the place
+ * where register sequences are tried.
+ *
+ * WHAT IS GUESSED AND WHAT IS NOT
+ *
+ * Not guessed: the register offsets, the bit meanings, the absence of IPS from
+ * TCR, the queue layout -- all measured.  Not guessed: that the vote has to
+ * happen, because two runs showed POWER_ON refusing to rise without it.
+ *
+ * Guessed: the *level* to vote for.  The shim read the rail's corner list out
+ * of cmd-db and the top corner was 192, so that is what is asked for; the boot
+ * argument `sweetgpulvl` overrides it, and the log prints what the rail held
+ * before and after so the next run can correct it from evidence.
+ *
+ * BOOT ARGUMENT
+ *
+ *     sweetgpu=1        attempt it at all (default off: this must not be able
+ *                       to break a normal boot)
+ *     sweetgpulvl=<n>   the level to vote for (default 192)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int sweet_rpmh_gpu_rail_vote(const char *res, uint32_t level);
+
+#define GPUCC_BASE	0x05090000UL
+#define GPUCC_GX_GDSCR	0x100c
+
+#define GDSC_SW_COLLAPSE	(1u << 0)
+#define GDSC_POWER_ON		(1u << 31)
+
+static vm_offset_t gpucc;
+
+static uint32_t
+gpucc_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(gpucc + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gpucc_wr(uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(gpucc + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/*
+ * Turn the GX domain on.  Returns 0 when POWER_ON is set afterwards.
+ *
+ * The order is: vote the rail, then release the switch, then wait.  Releasing
+ * the switch first was tried from the shim and produced 0x02220000 with the
+ * domain still dark, so the vote has to come first.
+ */
+int
+sweet_gpu_gx_power_on(uint32_t level)
+{
+	uint32_t before, after;
+	int error;
+
+	if (!gpucc) {
+		gpucc = ml_io_map(GPUCC_BASE, 0x10000);
+		if (!gpucc) {
+			printf("SWEET GPU: GPUCC did not map\n");
+			return ENOMEM;
+		}
+	}
+
+	before = gpucc_rd(GPUCC_GX_GDSCR);
+	printf("SWEET GPU: GX GDSCR before: %#x (power_on=%u sw_collapse=%u)\n",
+	    before, (before >> 31) & 1, before & 1);
+
+	if (before & GDSC_POWER_ON) {
+		printf("SWEET GPU: GX was already on; nothing to do\n");
+		return 0;
+	}
+
+	/*
+	 * The vote.  This is the step the probe images could not take: the TCS
+	 * registers belong to sweet_rpmh.c.
+	 */
+	printf("SWEET GPU: voting gfx.lvl = %u\n", level);
+	error = sweet_rpmh_gpu_rail_vote("gfx.lvl", level);
+	if (error) {
+		printf("SWEET GPU: the rail vote failed (%d); GX will stay off\n", error);
+		return error;
+	}
+
+	/* Let the rail settle before asking the domain to use it. */
+	delay(10);
+
+	gpucc_wr(GPUCC_GX_GDSCR, before & ~GDSC_SW_COLLAPSE);
+	for (int i = 0; i < 500; i++) {
+		after = gpucc_rd(GPUCC_GX_GDSCR);
+		if (after & GDSC_POWER_ON)
+			break;
+		delay(1);
+	}
+	after = gpucc_rd(GPUCC_GX_GDSCR);
+	printf("SWEET GPU: GX GDSCR after: %#x (power_on=%u sw_collapse=%u)\n",
+	    after, (after >> 31) & 1, after & 1);
+
+	if (!(after & GDSC_POWER_ON)) {
+		printf("SWEET GPU: the rail vote landed but the domain did not come up\n");
+		return ENODEV;
+	}
+
+	printf("SWEET GPU: GX IS POWERED\n");
+	return 0;
+}
+
+/*
+ * Called once from sweet_ufs.c after the root is mounted, which is late enough
+ * that the RPMh client has been used successfully for L11C and early enough to
+ * be before anything wants the GPU.
+ *
+ * Off unless `sweetgpu=1`.  A bring-up step that can reset the GPU's rail has
+ * no business running on a normal boot.
+ */
+void
+sweet_gpu_init(void)
+{
+	int enabled = 0;
+	uint32_t level = 192;
+
+	(void)PE_parse_boot_argn("sweetgpu", &enabled, sizeof(enabled));
+	if (!enabled)
+		return;
+	(void)PE_parse_boot_argn("sweetgpulvl", &level, sizeof(level));
+
+	printf("SWEET GPU: starting (level %u)\n", level);
+	if (sweet_gpu_gx_power_on(level) == 0) {
+		printf("SWEET GPU: done; the shim's remaining steps can follow\n");
+	} else {
+		printf("SWEET GPU: gave up; see the lines above\n");
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
