 {
@@ -219,7 +250,8 @@ rh_free(unsigned t)
 }
 
 static int
-rh_send(uint32_t address, unsigned mv)
+rh_tcs_run(uint32_t address, const uint32_t *offsets, const uint32_t *values,
+    unsigned count, const char *what)
 {
 	int chosen = -1;
 	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
@@ -234,7 +266,8 @@ rh_send(uint32_t address, unsigned mv)
 		for (unsigned c = 0; c < rh_ncpt; ++c) {
 			if ((enabled & (1u << c)) &&
 			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
-				printf("SWEET RPMH: conflicting inherited L11C request in TCS%u\n", t);
+				printf("SWEET RPMH: conflicting inherited request for %s in TCS%u\n",
+				    what, t);
 				return EBUSY;
 			}
 		}
@@ -266,11 +299,9 @@ rh_send(uint32_t address, unsigned mv)
 	}
 	/* From here an uncertain write/timeout quarantines our slot for this boot. */
 	rh_poisoned = true;
-	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
-	const uint32_t offsets[3] = {0, 8, 4};
-	const uint32_t values[3] = {mv, 7, 1};
-	printf("SWEET RPMH: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
-	for (unsigned c = 0; c < 3; ++c) {
+	printf("SWEET RPMH: TCS%u %s: %u command(s), irq-enable=%#x\n",
+	    t, what, count, irq_en);
+	for (unsigned c = 0; c < count; ++c) {
 		uint32_t cmd = b + c * RH_CMD_STRIDE;
 		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
 		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
@@ -278,7 +309,8 @@ rh_send(uint32_t address, unsigned mv)
 			return EIO;
 		}
 	}
-	if (!rh_sync(b + RH_WAIT, 7) || !rh_sync(b + RH_ENABLE, 7) ||
+	if (!rh_sync(b + RH_WAIT, (1u << count) - 1u) ||
+	    !rh_sync(b + RH_ENABLE, (1u << count) - 1u) ||
 	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
 		return EIO;
 	}
@@ -289,7 +321,7 @@ rh_send(uint32_t address, unsigned mv)
 		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
 		idle = rh_read(rh_tcs, b + RH_STATUS);
 		bool complete = true;
-		for (unsigned c = 0; c < 3; ++c) {
+		for (unsigned c = 0; c < count; ++c) {
 			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
 			complete &= status[c] != 0xffffffffu &&
 			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
@@ -303,8 +335,9 @@ rh_send(uint32_t address, unsigned mv)
 		}
 		delay(1);
 	}
-	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
-	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	printf("SWEET RPMH: TCS%u %s done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, what, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL),
+	    status[0], status[1], status[2]);
 	if (!done) {
 		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
 		return ETIMEDOUT;
@@ -320,10 +353,20 @@ rh_send(uint32_t address, unsigned mv)
 		return EIO;
 	}
 	rh_poisoned = false;
-	printf("SWEET RPMH: L11C ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	printf("SWEET RPMH: %s ACTIVE vote complete\n", what);
 	return 0;
 }
 
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+
+	return rh_tcs_run(address, offsets, values, 3, "ldoc11");
+}
+
 int
 sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 {
@@ -355,4 +398,46 @@ out:
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+int
+sweet_rpmh_gpu_rail_vote(const char *res, uint32_t level)
+{
+	/*
+	 * A level rail (`gfx.lvl`, `mx.lvl`, `cx.lvl`) takes one command whose
+	 * data is the level the GMU's firmware would have voted for itself.
+	 * The resource address comes from cmd-db exactly as for L11C; the level
+	 * is the value the probe measured out of the rail's own list.
+	 *
+	 * Unlike the LDO lock, this takes rh_lock because it shares the TCS
+	 * registers: two votes at once would interleave commands in one slot.
+	 */
+	if (!res || strcmp(res, "gfx.lvl")) {
+		printf("SWEET RPMH: expected gfx.lvl, got %s\n", res ? res : "(null)");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_level(res, &address);
+	}
+	if (!error) {
+		const uint32_t offsets[1] = {0};
+		const uint32_t values[1] = {level};
+		error = rh_tcs_run(address, offsets, values, 1, res);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: %s vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
