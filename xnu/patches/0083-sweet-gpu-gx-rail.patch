 static int
 rh_lookup(const char *res, uint32_t *address)
+{
+	/*
+	 * Voltage regulators are the VRM slave, and their entries carry the
+	 * slave number in the top half of the address as a sanity check.  The
+	 * shared walker does that; this is the name the callers use.
+	 */
+	static int rh_lookup_slave(const char *, unsigned, uint32_t *);
+
+	return rh_lookup_slave(res, RH_VRM, address);
+}
+
+/*
+ * A level resource (gfx.lvl, mx.lvl, cx.lvl) lives in a different cmd-db slave
+ * from the voltage regulators: ARC is slave 3, the VRM that ldoc11 belongs to is
+ * slave 4.  The validation is the same shape, with the slave number as the
+ * parameter rather than a constant.
+ */
+static int
+rh_lookup_slave(const char *res, unsigned want_slave, uint32_t *address)
 {
 	uint32_t key[2] = {0, 0};
 	for (unsigned i = 0; i < 8 && res[i]; ++i) {
@@ -172,11 +191,14 @@ rh_lookup(const char *res, uint32_t *address)
 		if (!slave) {
 			break;
 		}
+		if (slave != want_slave) {
+			continue;
+		}
 		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
 		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
 		unsigned count = rh_db16(h + 6);
-		if (slave < 3 || slave > 5 || (entries & 3u) ||
-		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) ||
+		    !rh_range(aux, 0)) {
 			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
 			return EINVAL;
 		}
@@ -186,25 +208,34 @@ rh_lookup(const char *res, uint32_t *address)
 				continue;
 			}
 			uint32_t addr = rh_read(rh_db, e + 16);
-			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			if ((addr >> 16) != want_slave || (addr & 15u) ||
 			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
-				printf("SWEET RPMH: invalid VRM entry for %s\n", res);
+				printf("SWEET RPMH: %s: entry is not a slave %u resource (addr %#x)\n",
+				    res, want_slave, addr);
 				return EINVAL;
 			}
 			*address = addr;
 			++matches;
-			printf("SWEET RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
-			    res, addr, slave, rh_db16(h + 8),
-			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+			printf("SWEET RPMH: %s addr=%#x slave=%u length=%u\n",
+			    res, addr, slave, rh_db16(e + 20));
 		}
 	}
 	if (matches != 1) {
-		printf("SWEET RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		printf("SWEET RPMH: %s lookup matches=%u on slave %u; refusing\n",
+		    res, matches, want_slave);
 		return ENODEV;
 	}
 	return 0;
 }
 
+#define RH_SLAVE_ARC	3u
+
+static int
+rh_lookup_level(const char *res, uint32_t *address)
+{
+	return rh_lookup_slave(res, RH_SLAVE_ARC, address);
+}
+
 static bool
