+/*
+ * sweet_gmu.c - start the GMU firmware inside the kernel, then power GX.
+ *
+ * WHAT THIS IS
+ *
+ * The v6 boot measured the CPU-side GDSC path exhausted: the GX FSM leaves
+ * power_down_complete but never reaches POWER_UP_COMPLETE, and the SPTP
+ * sequencer reports its own domain and clock off (status 0x94) because the
+ * GMU firmware is not running when it is poked.  Mainline says exactly this
+ * (gdsc.c: the GX domain is "almost entirely controlled by the GMU running
+ * in the CX domain"; the CPU-side enable is gdsc_gx_do_nothing_enable).
+ *
+ * The shim proved the whole firmware path works on this phone, end to end:
+ * SMMU context with real stage-1 tables (fsr=0), firmware load into
+ * ITCM/DTCM, M3 to 0xbabeface in 400 us, all four legacy HFI messages
+ * answered (INIT, FW_VERSION, PERF_TABLE built from the phone's own cmd-db
+ * corners, BW_TABLE).  This file is that proven chain, ported into the
+ * kernel driver, in the shim's measured order -- which is mainline's
+ * a6xx_gmu_fw_start() order:
+ *
+ *     1. rail vote gfx.lvl (sweet_rpmh, proven)      - the GPU rail
+ *     2. CX up, bus clocks, GPLL0, GMU clocks        - proven v4-v6 sequence
+ *     3. firmware load (32 KiB verbatim to ITCM)     - shim gmustart.c
+ *     4. env setup, then SMMU tables IN THE M3-HELD GAP
+ *        (the shim's gmu_before_start hook: a started M3 faults immediately
+ *        if the stream is not bound yet, and the hypervisor then clears the
+ *        stream entry)                              - shim context_setup()
+ *     5. M3 released, BABEFACE polled                - shim gmustart.c
+ *     6. GDSC GX SW_COLLAPSE clear (the domain cannot be powered by the
+ *        GMU while it is held collapsed; every GMU-register write to dark
+ *        silicon killed the firmware in the shim, three times over)
+ *     7. OOB BOOT_SLUMBER: slumber=0, votes, set bit 22 -> ack bit 30
+ * 8. SPTPRAC 0x778000, poll bits 5:3 == 0x28   - a6xx_sptprac_enable()
+ *     9. HFI_CTRL_INIT, poll status bit 0, then the four messages
+ *        INIT, FW_VERSION, PERF_TABLE, BW_TABLE     - shim smmu_pt.c
+ *
+ * Every stage prints its own verdict so a failure names its step.
+ *
+ * ADDRESS SPACES, the one thing this port must get right
+ *
+ * The shim ran with the MMU off, so every address it wrote was physical.
+ * The kernel runs virtual.  Four address spaces are in play:
+ *
+ *   - CPU virtual:  gbuf (this driver's kernel VA).  CPU reads/writes.
+ *   - CPU physical: gbuf_pa.  What the CPU's writes land at in RAM.
+ *   - GMU bus:      what the GMU emits on its stream.  The SMMU context
+ *                   translates it.  The shim gave the firmware an identity
+ *                   window, so the queue addresses written into the HFI
+ *                   registers and the queue table were physical CPU
+ *                   addresses.
+ *
+ * Measured on sweet (boot v7.1): kernel-managed RAM starts at 4 GiB, so a
+ * physical under-4-GiB allocation cannot exist (vm_page_find_contiguous
+ * bailed after 2 pages at max_pnum=262143 with 255k free pages).  The GMU
+ * therefore sees the buffers through an SMMU window at IOVA 0xC0000000 --
+ * the shim's MAP_BASE, which was an identity map only because the shim's
+ * buffer sat at the same physical address.  HFI_QTBL_ADDR is 32 bits, which
+ * fits an IOVA, not the physical address of any page this kernel owns.
+ * The SMMU context maps seven 4 KiB pages: IOVA 0xC0000000 + i*0x1000 ->
+ * gbuf_pa + i*0x1000, i = 0..6 (three-level walk L1 -> L2 -> L3, 4 KiB
+ * granule); every GMU-visible value is built from GMU_IOVA_BASE.
+ *
+ * CACHES
+ *
+ * The GMU reads RAM, not CPU caches: every page the firmware or the SMMU
+ * walks is flushed to PoC after the CPU writes it, and the queue headers
+ * are flushed before the CPU reads what the GMU wrote (sweet_ufs.c does
+ * the same for the UFS host, which is likewise not cache-coherent).  The
+ * invalidate side is not represented in this tree's caches_internal.h, so
+ * the reads go through flush_dcache64 on the physical range, the pattern
+ * sweet_ufs.c uses.
+ *
+ * BOOT ARGUMENT
+ *
+ *     sweetgpu=1        attempt it at all (default off)
+ *     sweetgpulvl=<n>   the rail level to vote for (default 192)
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+
+#include <stdint.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern int sweet_rpmh_gpu_rail_vote(const char *res, uint32_t level);
+extern const uint32_t sweet_gmu_fw[];
+extern const unsigned sweet_gmu_fw_words;
+
+#include "sweet_gpu_regs.h"
+#include "sweet_gmu_hfi.h"
+
+/* -------------------------------------------------------------------- */
+/* registers                                                             */
+/* -------------------------------------------------------------------- */
+
+static vm_offset_t gpucc, gcc, gmu, smmu;
+
+static uint32_t
+reg_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+reg_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+#define gmu_rd(off)		reg_rd(gmu, (off))
+#define gmu_wr(off, v)		reg_wr(gmu, (off), (v))
+#define gpucc_rd(off)		reg_rd(gpucc, (off))
+#define gpucc_wr(off, v)	reg_wr(gpucc, (off), (v))
+#define gcc_rd(off)		reg_rd(gcc, (off))
+#define gcc_wr(off, v)		reg_wr(gcc, (off), (v))
+#define smmu_rd(off)		reg_rd(smmu, (off))
+#define smmu_wr(off, v)		reg_wr(smmu, (off), (v))
+
+/*
+ * Invalidate the CPU's view of a physical range, then read it back.  The
+ * tree has no InvalidatePoU_DcacheRegion; flush_dcache64 on the physical
+ * address both writes the lines back and drops them, which is what the
+ * read side needs (sweet_ufs.c's dma_sync()).
+ */
+static uint32_t
+phys_rd32(uint32_t pa)
+{
+	flush_dcache64((addr64_t)((vm_offset_t)pa & ~63ul), 64, TRUE);
+	return *(volatile uint32_t *)(vm_offset_t)pa;
+}
+
+/* -------------------------------------------------------------------- */
+/* the memory the GMU and the SMMU walk                                  */
+/* -------------------------------------------------------------------- */
+
+/*
+ * The shim's layout: the queue table, its three queue buffers, the log and
+ * the three SMMU tables sit in ONE contiguous allocation of GBUF_SIZE
+ * (32 KiB = two 16 KiB kernel pages).  The UFS driver's identical
+ * allocation shape (PAGE_MASK, no cap) succeeds on every boot, so this
+ * one must too.
+ *
+ *     +0x0000  HFI queue table page (header + 3 queue headers)
+ *     +0x1000  command queue buffer     (1024 dwords)
+ *     +0x2000  response queue buffer
+ *     +0x3000  debug queue buffer
+ *     +0x4000  firmware log page
+ *     +0x5000  SMMU level-1 table (4 KiB)
+ *     +0x6000  SMMU level-2 table  (4 KiB)
+ *     +0x7000  SMMU level-3 table  (4 KiB)
+ *     +0x8000  end
+ */
+#define GBUF_QTBL		0x0000u
+#define GBUF_QDATA		0x1000u		/* + q * 0x1000 */
+#define GBUF_LOG		0x4000u
+#define GBUF_L1			0x5000u
+#define GBUF_L2			0x6000u
+#define GBUF_L3			0x7000u
+#define GBUF_SIZE		0x8000u
+
+/* The seven buffer pages the SMMU maps 1:1 into the GMU's IOVA window. */
+#define GBUF_PAGES		(GBUF_L3 / 0x1000u)
+
+#define QDATA(q)	(GBUF_QDATA + (q) * 0x1000u)
+
+/* One 4 KiB page per queue buffer, in dwords. */
+#define GMU_QUEUE_BUF_DWORDS	1024u
+
+/* The queue header for queue q, byte offset inside the block. */
+#define QHDR(q)		(GBUF_QTBL + 24u + (q) * 48u)
+
+static vm_offset_t gbuf;                /* kernel VA */
+static uint64_t gbuf_pa;                /* physical base of the block */
+
+/* The GMU-visible window: the SMMU maps this IOVA -> gbuf_pa. */
+#define GMU_IOVA_BASE		0xc0000000ull
+
+static int
+gbuf_alloc(void)
+{
+	kern_return_t kr;
+
+	if (gbuf)
+		return 0;
+	/*
+	 * GBUF_SIZE with page alignment and NO physical cap -- the exact
+	 * shape of sweet_ufs.c's DMA allocation that succeeds every boot.
+	 * (Measured: a 2 MiB contig request with any cap below 4 GiB
+	 * returns KERN_NO_SPACE -- kernel RAM starts at 4 GiB -- and with
+	 * no cap the 2 MiB scan is so slow the watchdog resets the phone
+	 * before it finishes.  32 KiB needs just 2 pages.)
+	 */
+	kr = kmem_alloc_contig(kernel_map, &gbuf, GBUF_SIZE,
+	    PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) {
+		printf("SWEET GMU: contiguous memory failed %d\n", kr);
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)gbuf);
+	if (!pn) {
+		printf("SWEET GMU: no physical page for buffers\n");
+		return ENOMEM;
+	}
+	gbuf_pa = ptoa_64(pn);
+	printf("SWEET GMU: buffers at %#llx (va %#llx)\n",
+	    (unsigned long long)gbuf_pa, (unsigned long long)gbuf);
+	return 0;
+}
+
+/*
+ * Flush a buffer range to PoC so the GMU and the SMMU's walkers read what
+ * the CPU wrote (physical addresses; the GMU has no visibility into CPU
+ * caches).
+ */
+static void
+gbuf_clean(uint32_t off, uint32_t len)
+{
+	uint32_t base = off & ~63u, end = (off + len + 63u) & ~63u;
+
+	clean_dcache64((addr64_t)(gbuf_pa + base), end - base, TRUE);
+}
+
+/* Forward declarations used before their definitions below. */
+static int rail_vote(uint32_t corner, uint32_t *out);
+static int smmu_context_setup(void);
+
+/* Flush-and-read: drop the CPU's stale lines, then read what the GMU wrote. */
+static void
+gbuf_sync_read(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(gbuf_pa + (off & ~63u)),
+	    ((off + len + 63u) & ~63u) - (off & ~63u), TRUE);
+}
+
+static inline void
+buf_wr32(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(gbuf + off) = v;
+}
+
+static inline uint32_t
+buf_rd32(uint32_t off)
+{
+	return *(volatile uint32_t *)(gbuf + off);
+}
+
+/* -------------------------------------------------------------------- */
+/* SMMU: stream 5 -> context 0, real stage-1 tables                      */
+/* -------------------------------------------------------------------- */
+
+/*
+ * The shim's shape (smmu_pt.c context_setup(), which measured fsr=0
+ * through firmware start and the whole HFI handshake), extended one level
+ * down: a three-level 39-bit stage-1 table mapping seven 4 KiB pages.
+ * TCR starts walks at level 1 with a 4 KiB granule, so:
+ *
+ *   root  (level 1, 4 KiB): entry (iova >> 30) -> the level-2 table
+ *   l2    (level 2, 4 KiB): entry (iova >> 21) & 0x1ff -> the level-3 table
+ *   l3    (level 3, 4 KiB): entry (iova >> 12) & 0x1ff is a 4 KiB page
+ *
+ * The shim mapped one 2 MiB BLOCK (its buffer sat at a 2 MiB-aligned
+ * physical address with the MMU off).  Here the block is 32 KiB at an
+ * arbitrary page-aligned physical base, so the walk must reach level 3:
+ * the l2 descriptor is a TABLE pointer, and the l3 entries are PAGE
+ * descriptors (type 3, the shim's own PTE_PAGE).
+ *
+ * Runs with the M3 still held: a context can only be set up without the
+ * firmware's own accesses racing the writes while it is in reset.
+ */
+static int
+smmu_context_setup(void)
+{
+	uint64_t root = gbuf_pa + GBUF_L1;
+	uint64_t l2 = gbuf_pa + GBUF_L2;
+	uint64_t l3 = gbuf_pa + GBUF_L3;
+	/*
+	 * The GMU's window: root[3] covers IOVA 0xC0000000..0xFFFFFFFF
+	 * ((0xc0000000 >> 30) & 0x1ff = 3); entry 0 of that level-2 table
+	 * covers 0xC0000000..0xC01FFFFF; the level-3 table hangs off that
+	 * entry, and its pages 0..6 map GMU_IOVA_BASE + i*0x1000 ->
+	 * gbuf_pa + i*0x1000 for the seven buffer pages.
+	 */
+	uint32_t gig = (GMU_IOVA_BASE >> 30) & 0x1ff;
+	uint32_t blk = (GMU_IOVA_BASE >> 21) & 0x1ff;
+	uint32_t pg = (GMU_IOVA_BASE >> 12) & 0x1ff;
+	uint64_t pte;
+	uint32_t v;
+
+	/* Level-1 table: all zero, then root[gig] -> the level-2 table. */
+	for (uint32_t i = 0; i < 512; i++) {
+		buf_wr32(GBUF_L1 + i * 8, 0);
+		buf_wr32(GBUF_L1 + i * 8 + 4, 0);
+	}
+	pte = l2 | SMMU_PTE_TABLE;
+	buf_wr32(GBUF_L1 + gig * 8, (uint32_t)pte);
+	buf_wr32(GBUF_L1 + gig * 8 + 4, (uint32_t)(pte >> 32));
+
+	/*
+	 * Level-2 table: all zero, then l2[blk] -> the level-3 table.
+	 * TABLE is bits [1:0] = 3 (valid + table); a previous generation
+	 * of this file wrote "1" here, which is a BLOCK descriptor type,
+	 * not a table pointer.
+	 */
+	for (uint32_t i = 0; i < 512; i++) {
+		buf_wr32(GBUF_L2 + i * 8, 0);
+		buf_wr32(GBUF_L2 + i * 8 + 4, 0);
+	}
+	pte = l3 | SMMU_PTE_TABLE;
+	buf_wr32(GBUF_L2 + blk * 8, (uint32_t)pte);
+	buf_wr32(GBUF_L2 + blk * 8 + 4, (uint32_t)(pte >> 32));
+
+	/*
+	 * Level-3 table: all zero, then seven PAGE descriptors mapping
+	 * IOVA GMU_IOVA_BASE + i*0x1000 -> gbuf_pa + i*0x1000.  PAGE is
+	 * type 3 (valid + page), the shim's own PTE_PAGE.
+	 */
+	for (uint32_t i = 0; i < 512; i++) {
+		buf_wr32(GBUF_L3 + i * 8, 0);
+		buf_wr32(GBUF_L3 + i * 8 + 4, 0);
+	}
+	for (uint32_t i = 0; i < GBUF_PAGES; i++) {
+		pte = (gbuf_pa + i * 0x1000ull) | SMMU_PTE_ATTR_CACHED |
+		    SMMU_PTE_SHARED | SMMU_PTE_ACCESSED | SMMU_PTE_NOT_GLOBAL |
+		    SMMU_PTE_PAGE;
+		buf_wr32(GBUF_L3 + (pg + i) * 8, (uint32_t)pte);
+		buf_wr32(GBUF_L3 + (pg + i) * 8 + 4, (uint32_t)(pte >> 32));
+	}
+	gbuf_clean(GBUF_L1, 0x3000);		/* all three tables */
+
+	/*
+	 * The context, in arm_smmu_write_context_bank() order, values the
+	 * shim measured.  SCTLR last: M turns the context on, so everything
+	 * it depends on has to be in place first.
+	 */
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_SCTLR, 0);
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_FSR, 0xffffffffu);
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_FAR, 0);
+
+	/* CBA2R: 64-bit TTBR0, no VMID16 (this SMMU has 8-bit VMIDs). */
+	smmu_wr(SMMU_GR1_CBA2R(GMU_CTX), 1);
+	/* CBAR: stage-1, weakest shareability and memory attributes. */
+	smmu_wr(SMMU_GR1_CBAR(GMU_CTX), SMMU_CBAR_STAGE_1);
+
+	/* TCR2 first, then TCR: the order matters for ASID[15:8]. */
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_TCR2, SMMU_TCR2);
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_TCR, SMMU_TCR);
+
+	/* TTBR0: the root table (full 64 bits: the tables live above 4 GiB). */
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_TTBR0, (uint32_t)root);
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_TTBR0 + 4, (uint32_t)(root >> 32));
+
+	/* MAIRs, stage-1 only. */
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_MAIR0, SMMU_MAIR0);
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_MAIR1, 0);
+
+	/* Forget any stale translation, then enable. */
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_TLBIASID, GMU_CTX);
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_TLBSYNC, 1);
+	for (int i = 0; i < 1000; i++) {
+		if ((smmu_rd(SMMU_CB(GMU_CTX) + SMMU_CB_TLBSTATUS) & 1) == 0)
+			break;
+		delay(1);
+	}
+
+	/* SCTLR last: M turns the context on. */
+	smmu_wr(SMMU_CB(GMU_CTX) + SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+
+	/* Bind stream 5 to context 0.  S2CR before SMR, as the shim did. */
+	smmu_wr(SMMU_GR0_S2CR(GMU_CTX), SMMU_S2CR_TRANSLATE | GMU_CTX);
+	smmu_wr(SMMU_GR0_SMR(GMU_CTX), SMMU_SM_VALID | GMU_STREAM);
+
+	v = smmu_rd(SMMU_GR0_SMR(GMU_CTX));
+	uint32_t s2cr = smmu_rd(SMMU_GR0_S2CR(GMU_CTX));
+	uint32_t sctlr = smmu_rd(SMMU_CB(GMU_CTX) + SMMU_CB_SCTLR);
+	uint32_t fsr = smmu_rd(SMMU_CB(GMU_CTX) + SMMU_CB_FSR);
+	uint32_t id2 = smmu_rd(SMMU_GR0_ID2);
+	printf("SWEET GMU: SMR %#x S2CR %#x SCTLR %#x TTBR0 %08x%08x FSR %#x ID2 %#x\n",
+	    v, s2cr, sctlr, (uint32_t)(root >> 32), (uint32_t)root, fsr, id2);
+
+	if (v != (SMMU_SM_VALID | GMU_STREAM) ||
+	    (s2cr & SMMU_S2CR_TYPE_MASK) != SMMU_S2CR_TRANSLATE) {
+		printf("SWEET GMU: stream did not bind\n");
+		return ENODEV;
+	}
+	if (fsr & 0xffffffffu) {
+		printf("SWEET GMU: context faulted during setup\n");
+		return ENODEV;
+	}
+	printf("SWEET GMU: SMMU context live (stream %u -> ctx %u)\n",
+	    GMU_STREAM, GMU_CTX);
+	return 0;
+}
+
+/* -------------------------------------------------------------------- */
+/* firmware load and start (gmustart.c, verbatim in shape)               */
+/* -------------------------------------------------------------------- */
+
+static int
+gmu_fw_load(void)
+{
+	uint32_t before = gmu_rd(GMU_ITCM_START);
+
+	printf("SWEET GMU: fw %u words (%u KiB), ITCM before %#x\n",
+	    sweet_gmu_fw_words, sweet_gmu_fw_words >> 4, before);
+	if (sweet_gmu_fw_words * 4u != 0x8000u) {
+		printf("SWEET GMU: firmware is not 0x8000 bytes: not this path\n");
+		return EINVAL;
+	}
+
+	/* The firmware is a constant in the image; make sure it is in RAM. */
+	CleanPoC_DcacheRegion((vm_offset_t)sweet_gmu_fw, 0x8000);
+
+	/* One word per ITCM-window register offset; runs straight into DTCM. */
+	for (uint32_t i = 0; i < sweet_gmu_fw_words; i++)
+		gmu_wr(GMU_ITCM_START + i * 4, sweet_gmu_fw[i]);
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	/* Read back three words: did the writes land? */
+	uint32_t itcm0 = gmu_rd(GMU_ITCM_START);
+	uint32_t itcm1 = gmu_rd(GMU_ITCM_START + 4);
+	uint32_t dtcm0 = gmu_rd(GMU_DTCM_START);
+	printf("SWEET GMU: ITCM %#x/%#x DTCM %#x (want %#x)\n",
+	    itcm0, itcm1, dtcm0, sweet_gmu_fw[0x4000 / 4]);
+
+	if (itcm0 != sweet_gmu_fw[0] || itcm1 != sweet_gmu_fw[1] ||
+	    dtcm0 != sweet_gmu_fw[0x4000 / 4]) {
+		printf("SWEET GMU: firmware did NOT land in the TCMs\n");
+		return EIO;
+	}
+	printf("SWEET GMU: firmware is in ITCM and DTCM\n");
+	return 0;
+}
+
+/*
+ * a6xx_gmu_power_config()'s part the firmware reads as it initialises,
+ * plus the HFI addresses.  Runs with the M3 held in reset.
+ */
+static void
+gmu_env_setup(void)
+{
+	/*
+	 * STEP prints before each register write: the screen (sweetfb)
+	 * shows these even when the kernel dies before the UFS log
+	 * flushes, so the next photo pins a hang to the exact step.
+	 * (Boot v7.2 died between the fw verdict and "RSC req="; the
+	 * cause was measured: the RSCC registers at byte 0x24c1c sat
+	 * outside the old 0x20000 mmio window.)
+	 */
+	printf("SWEET GMU: env step 1/7 sys_bus\n");
+	gmu_wr(GMU_SYS_BUS_CONFIG, 0x1);
+	printf("SWEET GMU: env step 2/7 icache\n");
+	gmu_wr(GMU_ICACHE_CONFIG, 0x1);
+	printf("SWEET GMU: env step 3/7 dcache\n");
+	gmu_wr(GMU_DCACHE_CONFIG, 0x1);
+	printf("SWEET GMU: env step 4/7 ifpc_ctrl\n");
+	gmu_wr(GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+	printf("SWEET GMU: env step 5/7 ifpc_hyst\n");
+	gmu_wr(GMU_PWR_COL_INTER_FRAME_HYST, 0x000a1680);
+	printf("SWEET GMU: env step 6/7 sptprac_hyst\n");
+	gmu_wr(GMU_PWR_COL_SPTPRAC_HYST, 0x000a1680);
+
+	/*
+	 * The RPMh client.  a6xx_rpmh_start() skips its RSC handshake on a
+	 * cold boot (PDC_SLEEP is never set), so only the register matters;
+	 * the vote bits are 4,8,9,10,11 -- 0xf11, not 0x3.
+	 */
+	printf("SWEET GMU: env step 7/7 rscc reads\n");
+	printf("SWEET GMU: RSC req=%#x ack=%#x (cold boot: no handshake)\n",
+	    gmu_rd(GMU_RSCC_CONTROL_REQ), gmu_rd(GMU_RSCC_CONTROL_ACK));
+	gmu_wr(GMU_RPMH_CTRL, GMU_RPMH_CTRL_ENABLE_ALL);
+	printf("SWEET GMU: RPMH_CTRL %#x (want %#x)\n",
+	    gmu_rd(GMU_RPMH_CTRL), GMU_RPMH_CTRL_ENABLE_ALL);
+
+	/*
+	 * The queue table and its three queues (a6xx_hfi.h, all u32, no
+	 * padding).  A legacy GMU uses queue ids 0, 4 and 5 -- mainline's
+	 * a6xx_hfi_init().  Two details the shim got wrong before it got
+	 * them right: `size` is 168 BYTES, and there are three queues.
+	 */
+	static const uint32_t qid[QTBL_NUM_QUEUES] = {
+	    HFI_QID_CMD, HFI_QID_RESP, HFI_QID_DEBUG };
+
+	for (uint32_t i = 0; i < 0x1000; i += 4)
+		buf_wr32(GBUF_QTBL + i, 0);
+
+	for (uint32_t q = 0; q < QTBL_NUM_QUEUES; q++) {
+		uint32_t h = QHDR(q);
+		uint32_t data = QDATA(q);
+
+		for (uint32_t i = 0; i < GMU_QUEUE_BUF_DWORDS; i++)
+			buf_wr32(data + i * 4, 0);
+		buf_wr32(h + QHDR_STATUS * 4, 1);		/* running */
+		buf_wr32(h + QHDR_IOVA * 4, (uint32_t)(GMU_IOVA_BASE + data));
+		buf_wr32(h + QHDR_TYPE * 4, HFI_QTYPE(qid[q]));
+		buf_wr32(h + QHDR_SIZE_DWORDS * 4, GMU_QUEUE_BUF_DWORDS);
+		buf_wr32(h + QHDR_MSG_SIZE * 4, 0);
+		buf_wr32(h + QHDR_DROPPED * 4, 0);
+		buf_wr32(h + QHDR_RX_WATERMARK * 4, 1);
+		buf_wr32(h + QHDR_TX_WATERMARK * 4, 1);
+		buf_wr32(h + QHDR_RX_REQUEST * 4, 1);
+		buf_wr32(h + QHDR_TX_REQUEST * 4, 0);
+		buf_wr32(h + QHDR_READ_INDEX * 4, 0);
+		buf_wr32(h + QHDR_WRITE_INDEX * 4, 0);
+	}
+	buf_wr32(GBUF_QTBL + 0, QTBL_VERSION);
+	buf_wr32(GBUF_QTBL + 4, QTBL_SIZE);
+	buf_wr32(GBUF_QTBL + 8, QTBL_QHDR0_DWORDS);
+	buf_wr32(GBUF_QTBL + 12, QTBL_QHDR_SIZE_DWORDS);
+	buf_wr32(GBUF_QTBL + 16, QTBL_NUM_QUEUES);
+	buf_wr32(GBUF_QTBL + 20, QTBL_NUM_QUEUES);
+	gbuf_clean(GBUF_QTBL, 0x1000);		/* the table page */
+	gbuf_clean(GBUF_QDATA, 0x3000);		/* all three queue buffers */
+
+	/* The firmware's log page, zeroed so later content proves writes. */
+	for (uint32_t i = 0; i < 0x1000; i += 4)
+		buf_wr32(GBUF_LOG + i, 0);
+	gbuf_clean(GBUF_LOG, 0x1000);
+
+	printf("SWEET GMU: qtbl iova %#x, q0 type %#x rd_idx %#x\n",
+	    (uint32_t)(GMU_IOVA_BASE + GBUF_QTBL), buf_rd32(QHDR(0) + 8),
+	    buf_rd32(QHDR(0) + 4));
+
+	/* Hand the addresses to the firmware, in the GMU's IOVA window. */
+	gmu_wr(GMU_HFI_QTBL_ADDR, (uint32_t)(GMU_IOVA_BASE + GBUF_QTBL));
+	gmu_wr(GMU_HFI_QTBL_INFO, 1);
+	/* HFI_SFR_ADDR: the GPU chip id, mainline's massage of 0x06010800. */
+	gmu_wr(GMU_HFI_SFR_ADDR,
+	    (0x06010800u & 0xffff0000u) |
+	    ((0x06010800u << 4) & 0xf000u) |
+	    ((0x06010800u << 8) & 0x0f00u));
+	/* The log buffer and the CP message page: one page each, both ours. */
+	gmu_wr(GMU_PWR_COL_CP_MSG, (uint32_t)(GMU_IOVA_BASE + GBUF_LOG));
+	/* AHB fence range, as mainline sets it for a6xx before the start. */
+	gmu_wr(GMU_AHB_FENCE_RANGE_0, (1u << 31) | (0xau << 18) | 0xa0);
+	/* TCM retention on; a stale result would look like success. */
+	gmu_wr(GMU_GENERAL_7, 1);
+	gmu_wr(GMU_CM3_FW_INIT_RESULT, 0);
+	gmu_wr(GMU_CM3_BOOT_CONFIG, 0x02);
+	gmu_wr(GMU_CM3_CFG, 0x4052);
+}
+
+/*
+ * The M3-held gap: everything that must be true before the firmware
+ * executes its first memory access.  The GMU's stream needs its context
+ * HERE, not after the release: a started M3 issues accesses immediately,
+ * they hit the SMMU, and with no valid stream entry the hypervisor
+ * reacts by clearing the entry this code wrote -- the shim measured that
+ * exact shape (SMR read back with VALID gone).
+ */
+static int
+gmu_before_start(void)
+{
+	printf("SWEET GMU: --- SMMU context (M3 held) ---\n");
+	return smmu_context_setup();
+}
+
+static int
+gmu_start(void)
+{
+	/* Hold the M3 briefly, then let it run. */
+	gmu_wr(GMU_CM3_SYSRESET, 1);
+	delay(1);
+
+	int error = gmu_before_start();
+	if (error)
+		return error;
+
+	/* Two markers name a bus hang: "releasing" without "released" means
+	 * the SYSRESET write itself stopped the bus. */
+	printf("SWEET GMU: releasing the M3\n");
+	gmu_wr(GMU_CM3_SYSRESET, 0);
+	__asm__ volatile("dsb osh" ::: "memory");
+	printf("SWEET GMU: M3 released\n");
+
+	uint32_t result = 0;
+	uint32_t waited = 0;
+
+	for (int i = 0; i < 5000; i++) {	/* 0.5 s; mainline polls 100 ms */
+		result = gmu_rd(GMU_CM3_FW_INIT_RESULT);
+		if (result == GMU_FW_RUNNING || (result & GMU_FW_FAILED))
+			break;
+		delay(1);
+		waited += 1000;
+	}
+
+	printf("SWEET GMU: init result %#x after %u us\n", result, waited);
+	if (result == GMU_FW_RUNNING) {
+		printf("SWEET GMU: FIRMWARE IS RUNNING (0xbabeface)\n");
+		return 0;
+	}
+	if (result & GMU_FW_FAILED)
+		printf("SWEET GMU: firmware reported a FAILURE (bit 31)\n");
+	else
+		printf("SWEET GMU: no init word: the M3 did not reach it\n");
+	return EIO;
+}
+
+/* -------------------------------------------------------------------- */
+/* GX domain through the GMU: GDSC release, OOB rail, SPTPRAC            */
+/* -------------------------------------------------------------------- */
+
+/*
+ * Clear the GX GDSC's SW_COLLAPSE so the domain CAN come up.  The shim
+ * measured gdscr = 0x02220001 (bit 0 set, bit 31 clear) in every run, and
+ * proved three times that writes to a collapsed domain's GMU registers
+ * kill the firmware.  Mainline: a domain held in software collapse cannot
+ * be powered by the GMU or an RPMh vote until the bit is cleared.  v6
+ * measured that clearing it alone does not complete the FSM -- that is
+ * what the firmware is for.  (If the domain is already on, nothing is
+ * written.)
+ */
+static int
+gx_gdsc_release(void)
+{
+	uint32_t gdscr = gpucc_rd(GPUCC_GX_GDSCR);
+	uint32_t hw = gpucc_rd(GPUCC_CX_HW_CTRL);
+
+	printf("SWEET GMU: GX GDSCR %#x (power_on=%u sw_collapse=%u)\n",
+	    gdscr, (gdscr >> 31) & 1, gdscr & 1);
+	if ((gdscr | hw) & GDSC_POWER_ON) {
+		printf("SWEET GMU: GX already powered\n");
+		return 0;
+	}
+	if (gdscr & GDSC_HW_CONTROL) {
+		printf("SWEET GMU: GX under hardware control; not forcing\n");
+		return ENODEV;
+	}
+	gpucc_wr(GPUCC_GX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+	for (int i = 0; i < 500; i++) {
+		if (gpucc_rd(GPUCC_GX_GDSCR) & GDSC_POWER_ON)
+			break;
+		delay(1);
+	}
+	gdscr = gpucc_rd(GPUCC_GX_GDSCR);
+	printf("SWEET GMU: GX GDSCR now %#x (power_on=%u)\n",
+	    gdscr, (gdscr >> 31) & 1);
+	/* POWER_ON not rising here is EXPECTED (v6): the firmware's job. */
+	return 0;
+}
+
+/*
+ * a6xx_gmu_gfx_rail_on(): BOOT_SLUMBER_OPTION = 0, the packed vote indices,
+ * then the OOB handshake -- request bit 22, wait for ack bit 30.
+ */
+static int
+gmu_oob_boot_slumber(void)
+{
+	gmu_wr(GMU_BOOT_SLUMBER_OPTION, 0);
+
+	/* The top corner the rail actually has (the shim's 192). */
+	uint32_t vote = 0;
+
+	if (!rail_vote(192, &vote))
+		vote = 0;
+	gmu_wr(GMU_GX_VOTE_IDX, vote & 0xff);
+	gmu_wr(GMU_MX_VOTE_IDX, (vote >> 8) & 0xff);
+
+	printf("SWEET GMU: boot slumber cleared, gx vote %#x mx %#x\n",
+	    gmu_rd(GMU_GX_VOTE_IDX), gmu_rd(GMU_MX_VOTE_IDX));
+
+	/* GMU_OOB_BOOT_SLUMBER: request bit 22, ack bit 30 (legacy). */
+	gmu_wr(GMU_HOST2GMU_INTR_SET, 1u << 22);
+	for (int i = 0; i < 2000; i++) {
+		uint32_t info = gmu_rd(GMU_GMU2HOST_INTR_INFO);
+
+		if (info & (1u << 30)) {
+			gmu_wr(GMU_GMU2HOST_INTR_CLR, 1u << 30);
+			printf("SWEET GMU: OOB BOOT_SLUMBER acked after %d polls\n", i);
+			return 0;
+		}
+		delay(1);
+	}
+	printf("SWEET GMU: OOB BOOT_SLUMBER NOT acked (info %#x)\n",
+	    gmu_rd(GMU_GMU2HOST_INTR_INFO));
+	return ETIMEDOUT;
+}
+
+/*
+ * a6xx_sptprac_enable(): write 0x778000 and wait for bits 5:3 to read
+ * 0x28 -- the core's own power/clock controller has handed over.  Only
+ * now is the domain actually powered; on its own this write is a bus
+ * access to the core's domain, and the shim proved what it costs when
+ * the domain is dark (it killed the queue with a single write).
+ */
+static int
+sptprac_enable(void)
+{
+	uint32_t status = 0;
+
+	gmu_wr(GMU_GX_SPTPRAC_POWER_CONTROL, 0x778000);
+	for (int i = 0; i < 1000; i++) {
+		status = gmu_rd(GMU_SPTPRAC_PWR_CLK_STATUS);
+		if ((status & 0x38) == 0x28)
+			break;
+		delay(1);
+	}
+	printf("SWEET GMU: SPTPRAC status %#x (want bits 5:3 = 0x28)\n", status);
+	return ((status & 0x38) == 0x28) ? 0 : ETIMEDOUT;
+}
+
+/* -------------------------------------------------------------------- */
+/* the HFI handshake (smmu_pt.c's four messages)                         */
+/* -------------------------------------------------------------------- */
+
+/*
+ * The rail lists and votes come from the phone's own cmd-db; until
+ * sweet_rpmh exports level reads, the lists the shim measured are used.
+ * The vote packing is a6xx_gmu_rpmh_arc_votes_init():
+ *     vote = rail_level << 16 | mx_index << 8 | rail_index
+ * The CORNER values, not loop indices: rail_vote() looks the corner up in
+ * the rail's own list.  The reference driver uses {0, 64, 128, 192} on
+ * this hardware (build/gh/adreno.c:2290); passing 0..7 is why an earlier
+ * run reported gx_used=3.
+ */
+struct perf_level {
+	uint32_t khz;
+	uint32_t corner;
+};
+
+static const struct perf_level perf_speeds[] = {
+	{ 825000, 192 }, { 800000, 192 }, { 650000, 192 },
+	{ 565000, 128 }, { 430000, 128 },
+	{ 355000,  64 }, { 267000,  64 },
+	{ 180000,   0 },
+};
+
+/* The shim's measured rail lists (cmd-db aux data, gfx.lvl / mx.lvl / cx.lvl). */
+static const uint16_t rail_gfx[] = { 0, 16, 64, 128, 192, 256 };
+static const uint16_t rail_mx[] = { 0, 8, 24, 48, 96, 144, 192, 240 };
+static const uint16_t rail_cx[] = { 0, 48 };
+
+/* The vote for a rail level: rail level << 16 | mx index << 8 | gfx index. */
+static int
+rail_vote(uint32_t corner, uint32_t *out)
+{
+	uint32_t at, with = 0;
+
+	for (at = 0; at < sizeof(rail_gfx) / sizeof(rail_gfx[0]) &&
+	    rail_gfx[at] < corner; at++)
+		;
+	if (at >= sizeof(rail_gfx) / sizeof(rail_gfx[0]))
+		return 0;
+	while (with + 1 < sizeof(rail_mx) / sizeof(rail_mx[0]) &&
+	    rail_mx[with] < rail_gfx[at])
+		with++;
+	*out = (rail_gfx[at] << 16) | (with << 8) | at;
+	return 1;
+}
+
+/*
+ * Send one message: advance write_index, ring the doorbell, wait for the
+ * GMU to consume it (read_index moving is the proof; the interrupt info
+ * bit is the secondary signal).  Returns 1 consumed, 0 silent.
+ */
+static int
+hfi_send(uint32_t at, uint32_t n)
+{
+	uint32_t wh = QHDR(0);
+
+	buf_wr32(wh + QHDR_WRITE_INDEX * 4, at + n);
+	/* The cursors live in the queue TABLE page: clean it, or the GMU
+	 * reads a stale write_index. */
+	gbuf_clean(GBUF_QTBL, 0x1000);
+	__asm__ volatile("dsb osh" ::: "memory");
+	gmu_wr(GMU_HOST2GMU_INTR_SET, 1);
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	for (int i = 0; i < 3000; i++) {	/* 0.3 s */
+		uint32_t info = gmu_rd(GMU_GMU2HOST_INTR_INFO);
+		uint32_t rd;
+
+		gbuf_sync_read(GBUF_QTBL, 0x100);
+		rd = buf_rd32(wh + QHDR_READ_INDEX * 4);
+		if (rd == at + n)
+			return 1;
+		if (info & 1) {
+			gmu_wr(GMU_GMU2HOST_INTR_CLR, 1);
+			gbuf_sync_read(GBUF_QTBL, 0x100);
+			rd = buf_rd32(wh + QHDR_READ_INDEX * 4);
+			return (rd == at + n) ? 1 : 0;
+		}
+		delay(1);
+	}
+	return 0;
+}
+
+/* Read `n` words from the response queue, dropping the CPU's stale lines. */
+static void
+hfi_resp(uint32_t *out, uint32_t n)
+{
+	gbuf_sync_read(QDATA(1), n * 4 < 0x40 ? 0x40 : (n * 4 + 63u) & ~63u);
+	for (uint32_t i = 0; i < n; i++)
+		out[i] = buf_rd32(QDATA(1) + i * 4);
+}
+
+static int
+hfi_ctrl_init(void)
+{
+	/* a6xx_gmu_hfi_start(): write CTRL_INIT, poll for status bit 0. */
+	gmu_wr(GMU_HFI_CTRL_INIT, 1);
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	uint32_t hfi = 0;
+
+	for (int i = 0; i < 100; i++) {		/* 10 ms, mainline's limit */
+		hfi = gmu_rd(GMU_HFI_CTRL_STATUS);
+		if (hfi & 1)
+			break;
+		delay(1);
+	}
+	uint32_t ver = gmu_rd(GMU_HFI_VERSION_INFO);
+	uint32_t qc = 0;
+
+	gbuf_sync_read(GBUF_QTBL, 0x100);
+	qc = buf_rd32(QHDR(0) + QHDR_READ_INDEX * 4);
+	printf("SWEET GMU: HFI ctrl=%#x ver=%#x q0_rd=%u\n", hfi, ver, qc);
+	return (hfi & 1) ? 0 : ETIMEDOUT;
+}
+
+static int
+hfi_handshake(void)
+{
+	uint32_t *q = (uint32_t *)(gbuf + QDATA(0));
+	uint32_t seq = 1;
+	int r;
+
+	/* ---- INIT (id 0): debug buffer, its size, boot state (cold) ---- */
+	q[0] = HFI_HEADER(seq, 0, 5, HFI_MSG_INIT);
+	q[1] = 0;				/* seg_id */
+	q[2] = (uint32_t)(GMU_IOVA_BASE + GBUF_LOG);	/* debug buffer */
+	q[3] = 0x1000;				/* its size */
+	q[4] = 0;				/* boot_state: cold */
+	gbuf_clean(QDATA(0), 0x1000);
+	r = hfi_send(0, 5);
+	printf("SWEET GMU: HFI INIT -> %d\n", r);
+	if (r != 1)
+		return EIO;
+
+	/* ---- FW_VERSION (id 1): offer 1.10; the reply carries its own -- */
+	{
+		uint32_t at = 5;
+
+		q[at + 0] = HFI_HEADER(seq + 1, 0, 2, HFI_MSG_FW_VERSION);
+		q[at + 1] = HFI_FW_VERSION;
+		gbuf_clean(QDATA(0), 0x1000);
+		r = hfi_send(at, 2);
+		uint32_t resp[3];
+
+		hfi_resp(resp, 3);
+		printf("SWEET GMU: HFI FW_VERSION -> %d, firmware speaks %#x\n",
+		    r, resp[0]);
+		if (r != 1)
+			return EIO;
+	}
+
+	/* ---- PERF_TABLE (id 4): the phone's own corners, 43 dwords ------ */
+	{
+		uint32_t seq3 = seq + 2;
+		uint32_t at = 7;		/* after INIT (5) + FW_VERSION (2) */
+		uint32_t filled = 0;
+
+		/* Zero the whole payload: the firmware never reads a stale
+		 * word from an earlier message. */
+		for (uint32_t i = 0; i < HFI_PERF_TABLE_SIZE; i++)
+			q[at + i] = 0;
+
+		for (uint32_t i = 0;
+		    i < sizeof(perf_speeds) / sizeof(perf_speeds[0]); i++) {
+			uint32_t v;
+
+			if (!rail_vote(perf_speeds[i].corner, &v))
+				continue;
+			q[at + 3 + filled * 2] = v;
+			q[at + 3 + filled * 2 + 1] = perf_speeds[i].khz;
+			filled++;
+		}
+		for (uint32_t i = filled; i < HFI_PERF_GX_MAX; i++) {
+			q[at + 3 + i * 2] = 0;
+			q[at + 3 + i * 2 + 1] = 0;
+		}
+
+		/* The cx table: two entries (corners 0 and 48). */
+		uint32_t cxfilled = 0;
+		static const uint32_t cx_corner[2] = { 0, 48 };
+
+		for (uint32_t i = 0; i < 2; i++) {
+			uint32_t at2 = 0, with = 0;
+
+			for (at2 = 0;
+			    at2 < sizeof(rail_cx) / sizeof(rail_cx[0]) &&
+			    rail_cx[at2] < cx_corner[i]; at2++)
+				;
+			if (at2 >= sizeof(rail_cx) / sizeof(rail_cx[0]))
+				continue;
+			while (with + 1 <
+			    sizeof(rail_mx) / sizeof(rail_mx[0]) &&
+			    rail_mx[with] < rail_cx[at2])
+				with++;
+			uint32_t v = (rail_cx[at2] << 16) | (with << 8) | at2;
+
+			q[at + 35 + cxfilled * 2] = v;
+			q[at + 35 + cxfilled * 2 + 1] =
+			    (i == 0) ? 0 : 200000;
+			cxfilled++;
+		}
+		for (uint32_t i = cxfilled; i < HFI_PERF_CX_MAX; i++) {
+			q[at + 35 + i * 2] = 0;
+			q[at + 35 + i * 2 + 1] = 0;
+		}
+
+		q[at] = HFI_HEADER(seq3, 0, HFI_PERF_TABLE_SIZE,
+		    HFI_MSG_PERFORMANCE_TABLE);
+		q[at + 1] = filled;
+		q[at + 2] = cxfilled;
+		gbuf_clean(QDATA(0), 0x1000);
+		r = hfi_send(at, HFI_PERF_TABLE_SIZE);
+		printf("SWEET GMU: HFI PERF_TABLE -> %d (gx=%u cx=%u)\n",
+		    r, filled, cxfilled);
+		if (r != 1)
+			return EIO;
+	}
+
+	/* ---- BW_TABLE (id 3): 160 dwords, the shim's accepted values ---- */
+	{
+		uint32_t seq4 = seq + 3;
+		uint32_t at = 50;	/* after INIT(5)+FWVER(2)+PERF(43) */
+		uint32_t d = 6;		/* first data word */
+
+		for (uint32_t i = 0; i < HFI_BW_TABLE_SIZE; i++)
+			q[at + i] = 0;
+
+		/* addresses: cnoc[6], then ddr[8].  CN0 and SH0 are the two
+		 * the firmware dereferences; the rest are sent as zero. */
+		q[at + d + 0] = 0x0005004cu;		/* CN0 */
+		q[at + d + 6 + 0] = 0x0005003cu;	/* SH0 */
+		q[at + d + 6 + 1] = 0;			/* MC0 */
+		q[at + d + 6 + 2] = 0;			/* ACV */
+
+		/* cnoc data[2][6]: one command, "no limit". */
+		uint32_t p = d + 14;
+
+		q[at + p + 0] = 0x40000000u;
+		q[at + p + 6] = 0x60000001u;
+
+		/* ddr data[16][8]: level 0 has three commands. */
+		p = d + 14 + 12;
+		q[at + p + 0] = 0x40000000u;
+		q[at + p + 1] = 0x40000000u;
+		q[at + p + 2] = 0x40000000u;
+
+		q[at] = HFI_HEADER(seq4, 0, HFI_BW_TABLE_SIZE,
+		    HFI_MSG_BANDWIDTH_TABLE);
+		q[at + 1] = 1;			/* bw_level_num */
+		q[at + 2] = 1;			/* cnoc_cmds_num */
+		q[at + 3] = 3;			/* ddr_cmds_num */
+		q[at + 4] = 1;			/* cnoc_wait_bitmask */
+		q[at + 5] = 7;			/* ddr_wait_bitmask */
+		gbuf_clean(QDATA(0), 0x1000);
+		r = hfi_send(at, HFI_BW_TABLE_SIZE);
+		printf("SWEET GMU: HFI BW_TABLE -> %d\n", r);
+		if (r != 1)
+			return EIO;
+	}
+
+	printf("SWEET GMU: ALL FOUR HFI MESSAGES ANSWERED\n");
+	return 0;
+}
+
+/* -------------------------------------------------------------------- */
+/* the GX verdict, from the register mainline trusts                     */
+/* -------------------------------------------------------------------- */
+
+static int
+gx_is_on(void)
+{
+	uint32_t cfg = gpucc_rd(GPUCC_GX_CFG_GDSCR);
+	uint32_t gdscr = gpucc_rd(GPUCC_GX_GDSCR);
+	uint32_t sp = gmu_rd(GMU_SPTPRAC_PWR_CLK_STATUS);
+
+	printf("SWEET GMU: GX CFG %#x (up_complete=%u down_complete=%u)\n",
+	    cfg, (cfg >> 16) & 1, (cfg >> 15) & 1);
+	printf("SWEET GMU: GX GDSCR %#x SP status %#x (gmu_up=%u gdsc_on=%u)\n",
+	    gdscr, sp, (sp >> 5) & 1, (sp >> 3) & 1);
+	return (cfg & GDSC_POWER_UP_COMPLETE) ? 1 : 0;
+}
+
+/* -------------------------------------------------------------------- */
+/* the sequence                                                          */
+/* -------------------------------------------------------------------- */
+
+/*
+ * Vote one GPUCC clock branch on.  v6 measured the refusal shape: bit 31
+ * returning means the parent PLL branch has no vote -- the GPLL0 votes
+ * above are what unlocked the GX branches.
+ */
+static void
+gpucc_clock_on(uint32_t off, const char *name)
+{
+	uint32_t v = gpucc_rd(off);
+
+	printf("SWEET GMU: %s before %#x\n", name, v);
+	if (v & CBCR_OFF) {
+		gpucc_wr(off, (v & ~CBCR_OFF) | CBCR_ON);
+		v = gpucc_rd(off);
+		printf("SWEET GMU: %s after clearing OFF %#x (on=%u)\n",
+		    name, v, v & 1);
+		return;
+	}
+	if (v & CBCR_ON) {
+		printf("SWEET GMU: %s already on\n", name);
+		return;
+	}
+	gpucc_wr(off, v | CBCR_ON);
+	v = gpucc_rd(off);
+	printf("SWEET GMU: %s after %#x (on=%u)\n", name, v, v & 1);
+}
+
+int
+sweet_gmu_boot(uint32_t level)
+{
+	int error;
+
+	if (!gpucc) {
+		gpucc = ml_io_map(GPUCC_BASE, 0x10000);
+		gcc = ml_io_map(GCC_BASE, 0x100000);
+		/*
+		 * 0x30000, not 0x20000: the RSCC block sits at mmio +
+		 * 0x23000 (mainline: gmu->rscc = gmu->mmio + 0x23000 for
+		 * every non-a650 GMU; sdm845's DT maps "gmu" as 0x30000).
+		 * Measured boot v7.2: the RSCC reads in gmu_env_setup()
+		 * (byte 0x24c1c) faulted outside a 0x20000 window -- the
+		 * kernel died between the firmware verdict and the "RSC
+		 * req=" print, exactly as the screen photo showed.
+		 */
+		gmu = ml_io_map(GMU_BASE, 0x30000);
+		smmu = ml_io_map(SMMU_BASE, 0x20000);
+		if (!gpucc || !gcc || !gmu || !smmu) {
+			printf("SWEET GMU: mapping failed\n");
+			return ENOMEM;
+		}
+	}
+
+	error = gbuf_alloc();
+	if (error)
+		return error;
+
+	/* 1. the rail (proven). */
+	printf("SWEET GMU: voting gfx.lvl = %u\n", level);
+	error = sweet_rpmh_gpu_rail_vote("gfx.lvl", level);
+	if (error) {
+		printf("SWEET GMU: the rail vote failed (%d)\n", error);
+		return error;
+	}
+	delay(10);
+
+	/* 2. CX (proven), then the bus, PLL and GMU clocks (proven). */
+	{
+		uint32_t gdscr = gpucc_rd(GPUCC_CX_GDSCR);
+		uint32_t hw = gpucc_rd(GPUCC_CX_HW_CTRL);
+
+		printf("SWEET GMU: CX GDSCR %#x\n", gdscr);
+		if (!((gdscr | hw) & GDSC_POWER_ON)) {
+			if (gdscr & GDSC_HW_CONTROL) {
+				printf("SWEET GMU: CX under hardware control\n");
+				return ENODEV;
+			}
+			gpucc_wr(GPUCC_CX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+			for (int i = 0; i < 500; i++) {
+				if ((gpucc_rd(GPUCC_CX_GDSCR) |
+				    gpucc_rd(GPUCC_CX_HW_CTRL)) & GDSC_POWER_ON)
+					break;
+				delay(1);
+			}
+		}
+		if (!((gpucc_rd(GPUCC_CX_GDSCR) |
+		    gpucc_rd(GPUCC_CX_HW_CTRL)) & GDSC_POWER_ON)) {
+			printf("SWEET GMU: CX did not come up\n");
+			return ENODEV;
+		}
+		printf("SWEET GMU: CX up\n");
+	}
+
+	gcc_wr(GCC_GPU_MEMNOC_GFX, gcc_rd(GCC_GPU_MEMNOC_GFX) | CBCR_ON);
+	gcc_wr(GCC_GPU_SNOC_DVM_GFX, gcc_rd(GCC_GPU_SNOC_DVM_GFX) | CBCR_ON);
+	gpucc_wr(GPUCC_SMMU_VOTE, gpucc_rd(GPUCC_SMMU_VOTE) | CBCR_ON);
+	delay(1);
+	{
+		uint32_t v = gcc_rd(GCC_PLL_VOTE) |
+		    GCC_GPU_GPLL0_VOTE | GCC_GPU_GPLL0_DIV_VOTE;
+
+		gcc_wr(GCC_PLL_VOTE, v);
+		printf("SWEET GMU: GCC_PLL_VOTE %#x (gpu=%u gpu_div=%u)\n",
+		    gcc_rd(GCC_PLL_VOTE), (v >> 15) & 1, (v >> 16) & 1);
+	}
+	gpucc_clock_on(GPUCC_CXO_AON, "CXO_AON");
+	gpucc_clock_on(GPUCC_CXO, "CXO");
+	gpucc_clock_on(GPUCC_AHB, "AHB");
+	gpucc_clock_on(GPUCC_CX_GMU, "CX_GMU");
+	delay(10);
+
+	/*
+	 * 3-5. firmware load, env, the M3-held SMMU gap, release, BABEFACE.
+	 * gmustart.c measured the whole of this at 400 us.
+	 */
+	printf("SWEET GMU: --- firmware load ---\n");
+	error = gmu_fw_load();
+	if (error)
+		return error;
+	gmu_env_setup();
+	printf("SWEET GMU: --- M3 start ---\n");
+	error = gmu_start();
+	if (error)
+		return error;
+
+	/*
+	 * 6. the GX GDSC's SW_COLLAPSE off.  POWER_ON not rising here is
+	 *    expected (v6): completing the FSM is the firmware's job, and
+	 *    it is what the OOB + SPTPRAC steps below ask it to do.
+	 */
+	printf("SWEET GMU: --- GX GDSC ---\n");
+	(void)gx_gdsc_release();
+
+	/* 7. the OOB rail request, with the firmware now processing it. */
+	printf("SWEET GMU: --- OOB BOOT_SLUMBER ---\n");
+	error = gmu_oob_boot_slumber();
+	if (error) {
+		printf("SWEET GMU: OOB failed (%d); GX cannot be powered\n",
+		    error);
+		return error;
+	}
+
+	/* 8. SPTPRAC: the sequencer with a live GMU behind it. */
+	printf("SWEET GMU: --- SPTPRAC ---\n");
+	error = sptprac_enable();
+
+	int gx = gx_is_on();
+
+	if (error) {
+		printf("SWEET GMU: SPTPRAC did not hand over (%d)\n", error);
+		return error;
+	}
+
+	/*
+	 * 9. the queues and the handshake.  The shim's order: the queues
+	 *    come up after the domain is powered -- without these two, the
+	 *    firmware is running but never gets permission to bring its
+	 *    queues up (smmufin.c measured ctrl=0 ver=0 on a valid table).
+	 */
+	printf("SWEET GMU: --- HFI start ---\n");
+	error = hfi_ctrl_init();
+	if (error)
+		return error;
+	printf("SWEET GMU: --- HFI handshake ---\n");
+	error = hfi_handshake();
+	if (error)
+		return error;
+
+	if (!gx)
+		gx = gx_is_on();
+	printf("SWEET GMU: %s\n",
+	    gx ? "GX IS POWERED (via the GMU)" :
+	    "GX CFG bit 16 did not rise; see the lines above");
+	return gx ? 0 : ENODEV;
+}
+
+/*
+ * Called once from sweet_ufs.c after the root is mounted.  Off unless
+ * sweetgpu=1: a bring-up sequence that resets the GPU rail has no
+ * business running on a normal boot.
+ */
+void
+sweet_gpu_init(void)
+{
+	int enabled = 0;
+	uint32_t level = 192;
+
+	(void)PE_parse_boot_argn("sweetgpu", &enabled, sizeof(enabled));
+	if (!enabled)
+		return;
+	(void)PE_parse_boot_argn("sweetgpulvl", &level, sizeof(level));
+
+	printf("SWEET GPU: starting (level %u)\n", level);
+	if (sweet_gmu_boot(level) == 0)
+		printf("SWEET GPU: done; the GMU booted and GX is up\n");
+	else
+		printf("SWEET GPU: gave up; see the lines above\n");
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
